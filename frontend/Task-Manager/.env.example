# Copy this file to .env.local for local overrides. Never commit real .env files.

# Backend URL, no trailing slash. Defaults to http://localhost:8000
VITE_API_URL=http://localhost:8000

# "true"  = live updates over Socket.io (local backend or Render)
# "false" = poll GET /api/notifications every 20 s (Vercel backend)
# Leave it unset to get "true" in `npm run dev` and "false" in production builds.
# VITE_ENABLE_SOCKET=true
